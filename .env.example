# CEST_Scout talks to any OpenAI-compatible chat endpoint that supports tool calling.
# Copy to .env and pick ONE of the options below. NCBI_EMAIL is always required.
NCBI_EMAIL=you@example.com
# Optional; raises the PubMed rate limit from 3 to 10 requests per second.
NCBI_API_KEY=

# --- Options 1-3: one of the three open-weight models CEST_Scout was evaluated with, served by
# vLLM (README, "Models"). LLM_PRESET sets all four agents to that model and turns thinking off.
# Choose: deepseek-v4-flash | qwen3.8-27b | qwen3.6-35b-a3b
LLM_PRESET=qwen3.8-27b
OPENAI_BASE_URL=http://localhost:8000/v1
# The --api-key given to `vllm serve`, or any non-empty string if the server has none.
OPENAI_API_KEY=EMPTY

# --- Option 4: OpenAI's own API instead (comment out the block above)
# LLM_PRESET=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_LITERATURE=gpt-5.5
# OPENAI_MODEL_CHEMIST=gpt-5.5
# OPENAI_MODEL_PHYSICIST=gpt-5.5
# OPENAI_MODEL_EXPERIMENTALIST=gpt-5.5

# --- Optional overrides (any option)
# A different model for one agent (wins over LLM_PRESET), e.g. the larger model for the physicist:
# OPENAI_MODEL_PHYSICIST=deepseek-v4-flash
# Route the physicist AND experimentalist agents through a second server (longer context):
# PHYSICIST_OPENAI_BASE_URL=http://localhost:8001/v1
# PHYSICIST_OPENAI_API_KEY=EMPTY
# PHYSICIST_LLM_DISABLE_THINKING=true
# Skip the PubMed Central full-text step of the clinical-evidence agent:
# CLINICAL_FULLTEXT=false
