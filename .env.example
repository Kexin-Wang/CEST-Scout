OPENAI_API_KEY=
NCBI_EMAIL=you@example.com
NCBI_API_KEY=
OPENAI_MODEL_LITERATURE=gpt-5.5
OPENAI_MODEL_CHEMIST=gpt-5.5
OPENAI_MODEL_PHYSICIST=gpt-5.5
OPENAI_MODEL_EXPERIMENTALIST=gpt-5.5

# --- Optional: point at a self-hosted OpenAI-compatible server instead of OpenAI ---
# e.g. the vLLM server started by ~/hpc-llm/serve.sh (see its printed connection info
# for the actual port/API key/tunnel command, which change per run):
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=<the api key printed by serve.sh>
# OPENAI_MODEL_LITERATURE=qwen3-32b
# OPENAI_MODEL_CHEMIST=qwen3-32b
# OPENAI_MODEL_PHYSICIST=qwen3-32b
# OPENAI_MODEL_EXPERIMENTALIST=qwen3-32b
# LLM_DISABLE_THINKING=true

# --- Optional: route the physicist AND experimentalist agents through a separate endpoint ---
# Both agents' tool-calling loops (many Bloch-McConnell simulate calls plus PubMed searches) need
# far more context than a small local model's window allows -- see pipeline.py's phys_client.
# Unset means both agents share the same client/model as literature/chemist above.
# PHYSICIST_OPENAI_API_KEY=<a key for the larger-context endpoint>
# PHYSICIST_OPENAI_BASE_URL=http://localhost:8001/v1
# PHYSICIST_LLM_DISABLE_THINKING=true
